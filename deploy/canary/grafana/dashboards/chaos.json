      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inventory_flow_requests_total{round=\"R0\",outcome=\"error\"}[30s])) or vector(0)",
          "legendFormat": "R0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "R1 | Flujos fallidos por segundo",
      "gridPos": {
        "x": 12,
