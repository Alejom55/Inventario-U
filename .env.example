# Desarrollo local: ajusta usuario, contraseña, host y nombre de base de datos.
DATABASE_URL=postgresql://inventario:inventario@localhost:5432/inventario
# Esta base debe ser distinta de la base de desarrollo o producción.
TEST_DATABASE_URL=postgresql://inventario:inventario@localhost:5432/inventario_test
# URL base de las APIs externas, sin slash final ni credenciales.
DEPORTBACK_API_URL=http://localhost:3000
FASTIFY_API_URL=http://localhost:3001
# Clave compartida opcional para llamadas entre servicios; no agregues un valor real.
TEAM_API_KEY=
